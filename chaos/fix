#!/usr/bin/env bash
# Undo ./chaos/break.
#
#   ./chaos/fix          everything
#   ./chaos/fix app-a    remove vendor latency
#   ./chaos/fix app-b    roll back pricing-v2 flag
#   ./chaos/fix app-c    turn off full-resync
#   ./chaos/fix kv       bring the data NATS back
set -euo pipefail
cd "$(dirname "$0")/.."

TOXI=http://localhost:8474
ok() { printf '\033[1;32m✅ %s\033[0m\n' "$*"; }

fix_latency() { curl -s -X DELETE "$TOXI/proxies/app-a-vendor/toxics/latency" >/dev/null || true
                curl -s -X DELETE "$TOXI/proxies/app-c-vendor/toxics/latency" >/dev/null || true
                ok "vendor latency removed"; }
NATS_DATA=${NATS_DATA:-nats://localhost:4224}   # the data NATS (sreday-nats-data container)

fix_flags()   { nats --server "$NATS_DATA" kv del "$1" flags --force >/dev/null 2>&1 || true
                ok "$1 feature flags cleared"; }
fix_kv()      { docker start sreday-nats-data >/dev/null
                for _ in $(seq 1 20); do nats --server "$NATS_DATA" kv ls >/dev/null 2>&1 && break; sleep 0.5; done
                ok "sreday-nats-data is back"; }

case "${1:-all}" in
  app-a) fix_latency ;;
  app-b) fix_flags app-b ;;
  app-c) fix_flags app-c ;;
  kv)    fix_kv ;;
  all)   fix_kv; fix_latency; fix_flags app-b; fix_flags app-c ;;
  *)     sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
