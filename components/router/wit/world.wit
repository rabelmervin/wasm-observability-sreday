package demo:router@0.1.0;

/// The platform entry point.
///
/// The same tenant interface is imported three times under different labels;
/// wasmCloud v2 links each label to the sibling component with that name.
///
/// wasi:http/incoming-handler is exported via wstd's #[http_server] macro,
/// so it does not appear here.
world router {
  import app-a: demo:tenant/handler@0.1.0;
  import app-b: demo:tenant/handler@0.1.0;
  import app-c: demo:tenant/handler@0.1.0;

  // Telemetry (src/telemetry.rs): spans + logs via wasi:otel.
  import wasi:otel/types@0.2.0-rc.2;
  import wasi:otel/tracing@0.2.0-rc.2;
  import wasi:otel/logs@0.2.0-rc.2;
  import wasi:clocks/wall-clock@0.2.0;
  import wasi:random/random@0.2.0;
}
