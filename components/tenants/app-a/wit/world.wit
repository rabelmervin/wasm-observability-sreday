package demo:app-a@0.1.0;

/// Tenant app-a / invoice-pdf.
/// Capabilities: keyvalue (incl. atomic counter), config, and outgoing HTTP to
/// its PDF vendor (via wstd; allowed host set in platform/.wash/config.yaml).
world app-a {
  import wasi:keyvalue/store@0.2.0-draft;
  import wasi:keyvalue/atomics@0.2.0-draft;
  import wasi:config/store@0.2.0-rc.1;
  export demo:tenant/handler@0.1.0;

  // Telemetry (src/telemetry.rs): spans + logs via wasi:otel.
  import wasi:otel/types@0.2.0-rc.2;
  import wasi:otel/tracing@0.2.0-rc.2;
  import wasi:otel/logs@0.2.0-rc.2;
  import wasi:clocks/wall-clock@0.2.0;
  import wasi:random/random@0.2.0;
}
