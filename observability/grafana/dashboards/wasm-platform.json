    {
      "id": 7,
      "type": "timeseries",
      "title": "Error rate % per tenant",
      "description": "5xx share per tenant, from the host's HTTP span: crashed requests count too.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 9,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "app-a"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "app-b"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "app-c"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tenant) (label_replace(100 * (sum by (url_path) (rate(traces_span_metrics_calls_total{service_name=\"wasmcloud-host\", span_kind=\"SPAN_KIND_SERVER\", url_path=~\"/t/.+\", status_code=\"STATUS_CODE_ERROR\"}[1m])) or 0 * sum by (url_path) (rate(traces_span_metrics_calls_total{service_name=\"wasmcloud-host\", span_kind=\"SPAN_KIND_SERVER\", url_path=~\"/t/.+\"}[1m]))) / sum by (url_path) (rate(traces_span_metrics_calls_total{service_name=\"wasmcloud-host\", span_kind=\"SPAN_KIND_SERVER\", url_path=~\"/t/.+\"}[1m])), \"tenant\", \"$1\", \"url_path\", \"/t/([^/]+)/.*\"))",
          "legendFormat": "{{tenant}}",
          "exemplar": false
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Why: top errors per tenant (5m)",
      "description": "Error messages the components reported, grouped by tenant and reason. Comes from the guest logs (Loki).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 9,
        "y": 12,
        "w": 11,
        "h": 8
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "namePlacement": "left",
        "valueMode": "color",
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum by (tenant_id, reason) (count_over_time({service_name=\"wasi-otel\"} | detected_level=\"error\" | resource_service_name != \"platform-router\" | regexp \"(?s)^(guest panic -> wasm trap: panicked at [^\\n]*\\n)?(?P<reason>.+)$\" | label_format reason=\"{{ trunc 80 .reason }}\" [5m]))",
          "legendFormat": "{{tenant_id}} · {{reason}}"
        }
      ]
    },
