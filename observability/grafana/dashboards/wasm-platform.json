        "orientation": "auto",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, tenant) (label_replace(sum by (le, url_path) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"wasmcloud-host\", span_kind=\"SPAN_KIND_SERVER\", url_path=~\"/t/.+\"}[1m])), \"tenant\", \"$1\", \"url_path\", \"/t/([^/]+)/.*\")))",
          "legendFormat": "{{tenant}} p50",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, tenant) (label_replace(sum by (le, url_path) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"wasmcloud-host\", span_kind=\"SPAN_KIND_SERVER\", url_path=~\"/t/.+\"}[1m])), \"tenant\", \"$1\", \"url_path\", \"/t/([^/]+)/.*\")))",
          "legendFormat": "{{tenant}} p95",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, tenant) (label_replace(sum by (le, url_path) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"wasmcloud-host\", span_kind=\"SPAN_KIND_SERVER\", url_path=~\"/t/.+\"}[1m])), \"tenant\", \"$1\", \"url_path\", \"/t/([^/]+)/.*\")))",
          "legendFormat": "{{tenant}} p99",
          "instant": true
        }
      ]
    },
