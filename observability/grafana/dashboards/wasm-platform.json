{
  "uid": "wasm-platform",
  "title": "Wasm Platform · Break It, Then Trace It",
  "tags": [
    "sreday",
    "wasmcloud"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "### 🧨 Break It, Then Trace It &nbsp;·&nbsp; 3 tenants, 1 wasmCloud v2 host\n**Latency · Errors · Traffic · Saturation · Availability** per tenant → **Why** (top errors) → **Trace** (click ◆ or a trace ID) → **Explain** (logs linked by trace_id)"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "1 · LATENCY: how long do requests take?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency per tenant (◆ = exemplar → trace)",
      "description": "From the host's HTTP span. Click a diamond to open that exact trace.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "app-a"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "app-b"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "app-c"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, tenant) (label_replace(sum by (le, url_path) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"wasmcloud-host\", span_kind=\"SPAN_KIND_SERVER\", url_path=~\"/t/.+\"}[1m])), \"tenant\", \"$1\", \"url_path\", \"/t/([^/]+)/.*\")))",
          "legendFormat": "{{tenant}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p50 · p95 · p99 per tenant (now)",
      "description": "Percentiles over the last minute. p99 shows the worst requests that p95 hides.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 250
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
